# =============================================================================
# API KEY CHO CHAT (bắt buộc nếu DEMO_MODE=false)
# =============================================================================
# Dán key OpenRouter vào dòng dưới (lấy tại https://openrouter.ai/keys):
OPENROUTER_API_KEY=

# Model qua OpenRouter (đổi nếu cần):
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=VinWonders Demo

# Provider backend đang dùng (hiện chỉ hỗ trợ openrouter):
AGENT_PROVIDER=openrouter

# --- Các provider khác (chưa bật trong code — để tham khảo / mở rộng sau) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# =============================================================================
# DEMO KHÔNG CẦN KEY
# =============================================================================
# true = trả lời mẫu + mock giá vé (không gọi LLM)
DEMO_MODE=false

# =============================================================================
# SERVER & AGENT
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
CHAT_MAX_TOOL_ROUNDS=4
CHAT_HISTORY_WINDOW=5

# =============================================================================
# DỮ LIỆU PHỤ (tùy chọn)
# =============================================================================
# Giá vé: mock (offline) | live (API VinWonders thật)
PRICES_MODE=mock
# Thời tiết thật (tool get_weather_forecast):
OPENWEATHER_API_KEY=
